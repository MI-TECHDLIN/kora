# AssemblyAI Voice Agent
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# ASSEMBLYAI_AGENT_ID=your_assemblyai_agent_id_here  # Optional: use inline tools if not set

# Supabase (Internal DB - deliveries, sessions, shifts, stats)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Twilio (Voice Calls & SMS notifications)
Account_SID=your_twilio_account_sid
Primary_auth_Token=your_twilio_auth_token
SID=your_twilio_api_key_sid
Client_secret=your_twilio_api_key_secret
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Google Maps (optional; navigation routes through OSRM, not Google Directions)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# OSRM routing (optional; defaults to the public demo server, no key needed)
# OSRM_BASE_URL=https://router.project-osrm.org

# Onfleet (Optional - External logistics platform, use mock if not provided)
ONFLEET_API_KEY=your_onfleet_api_key

# Order dispatch (optional; defaults shown). New orders are offered by voice to the nearest online driver
# LOGISTICS_WEBHOOK_SECRET=shared_secret_for_order_intake  # unset: POST /v1/logistics/orders answers 503
# ORDER_FEED_ENABLED=true                  # MockAdapter's random order feed (runs only while a driver is online)
# ORDER_FEED_MIN_INTERVAL_SECONDS=180      # each gap is drawn fresh from [min, max]
# ORDER_FEED_MAX_INTERVAL_SECONDS=420
# ORDER_FEED_MAX_OPEN_ORDERS=5
# ORDER_OFFER_WINDOW_SECONDS=75
# ORDER_DISPATCH_PING_MAX_AGE_MINUTES=     # ignore older GPS pings; unset: any

# n8n (Optional - Async dispatcher alerts via webhook)
N8N_DISPATCHER_WEBHOOK_URL=https://your-n8n-instance.com/webhook/dispatcher-alert

# App Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Environment
ENVIRONMENT=development
