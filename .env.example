# AssemblyAI Voice Agent
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# ASSEMBLYAI_AGENT_ID=your_assemblyai_agent_id_here  # Optional: use inline tools if not set

# Supabase (Internal DB - deliveries, sessions, shifts, stats)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# LiveKit SIP/PSTN (Outbound phone calls to customers - optional)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_SIP_TRUNK_ID=your_sip_trunk_id

# Google Maps (Directions API for routes + deeplink for navigation - optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Vonage SMS (Customer text notifications - global coverage - optional)
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_BRAND_NAME=VoiceOps

# Onfleet (Optional - External logistics platform, use mock if not provided)
ONFLEET_API_KEY=your_onfleet_api_key

# n8n (Optional - Async dispatcher alerts via webhook)
N8N_DISPATCHER_WEBHOOK_URL=https://your-n8n-instance.com/webhook/dispatcher-alert

# App Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Environment
ENVIRONMENT=development
