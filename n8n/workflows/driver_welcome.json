{
  "name": "VoiceOps - Driver Onboarding",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "driver-onboarding",
        "responseMode": "onReceived",
        "responseData": "{\"status\":\"received\",\"message\":\"Driver onboarding started\"}",
        "options": {}
      },
      "id": "dob-0001-0000-0000-000000000001",
      "name": "Webhook - Driver Registered",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1280, 300],
      "webhookId": "driver-onboarding"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "f1",  "name": "driver_id",       "value": "={{ $json.body.driver_id }}",       "type": "string" },
            { "id": "f2",  "name": "driver_name",     "value": "={{ $json.body.driver_name }}",     "type": "string" },
            { "id": "f3",  "name": "phone",           "value": "={{ $json.body.phone || '' }}",     "type": "string" },
            { "id": "f4",  "name": "email",           "value": "={{ $json.body.email || '' }}",     "type": "string" },
            { "id": "f5",  "name": "vehicle_type",    "value": "={{ $json.body.vehicle_type || 'Not set' }}", "type": "string" },
            { "id": "f6",  "name": "operator_name",   "value": "={{ $json.body.operator_name || 'VoiceOps' }}", "type": "string" },
            { "id": "f7",  "name": "registered_at",   "value": "={{ $json.body.registered_at || $now.toISO() }}", "type": "string" },
            { "id": "f8",  "name": "twilio_from",     "value": "={{ $json.body.twilio_from || '' }}", "type": "string" },
            { "id": "f9",  "name": "twilio_account_sid",  "value": "={{ $json.body.twilio_account_sid || '' }}", "type": "string" },
            { "id": "f10", "name": "twilio_auth_token",    "value": "={{ $json.body.twilio_auth_token || '' }}", "type": "string" },
            { "id": "f11", "name": "operator_email",  "value": "={{ $json.body.operator_email || 'ops@voiceops.app' }}", "type": "string" },
            { "id": "f12", "name": "supabase_url",    "value": "={{ $json.body.supabase_url || '' }}", "type": "string" },
            { "id": "f13", "name": "supabase_service_key", "value": "={{ $json.body.supabase_service_key || '' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "dob-0002-0000-0000-000000000002",
      "name": "Normalize Driver Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-1040, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.phone }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dob-0003-0000-0000-000000000003",
      "name": "IF Has Phone",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-800, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{ $json.twilio_account_sid }}/Messages.json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Basic {{ Buffer.from($json.twilio_account_sid + ':' + $json.twilio_auth_token).toString('base64') }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "From", "value": "={{ $json.twilio_from }}" },
            { "name": "To",   "value": "={{ $json.phone }}" },
            {
              "name": "Body",
              "value": "=Welcome to VoiceOps, {{ $json.driver_name }}! 🚀\n\nYou're all set to start your shifts.\n\nQuick Voice Commands:\n• \"Next stop\" → get delivery details & address\n• \"Call customer\" → connect via masked Twilio bridge\n• \"Alert dispatcher\" → immediate priority escalation\n• \"How am I doing?\" → live shift stats & completion rate\n\nDrive safe! 🙌\n— {{ $json.operator_name }}"
            }
          ]
        },
        "options": {}
      },
      "id": "dob-0004-0000-0000-000000000004",
      "name": "SMS - Welcome Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-560, 160],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "fromEmail": "welcome@voiceops.app",
        "toEmail": "={{ $json.operator_email }}",
        "subject": "=👋 New Driver Registered — {{ $json.driver_name }}",
        "emailFormat": "text",
        "text": "=A new driver has registered on VoiceOps.\n\nDriver Details:\nName:         {{ $json.driver_name }}\nPhone:        {{ $json.phone }}\nEmail:        {{ $json.email || 'Not provided' }}\nVehicle Type: {{ $json.vehicle_type }}\nRegistered:   {{ $json.registered_at }}\nDriver ID:    {{ $json.driver_id }}\n\nThe driver has been sent a welcome SMS with voice assistant instructions.\n\n— VoiceOps Onboarding System",
        "options": {}
      },
      "id": "dob-0005-0000-0000-000000000005",
      "name": "Email - Notify Operator",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [-560, 360],
      "credentials": { "smtp": { "id": "SMTP_CREDENTIAL_ID", "name": "VoiceOps SMTP" } },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#driver-onboarding" },
        "text": "=👋 *New Driver Registered*\n*Name:* {{ $json.driver_name }}\n*Phone:* {{ $json.phone }}\n*Vehicle:* {{ $json.vehicle_type }}\n*Registered:* {{ $json.registered_at }}\n*Driver ID:* {{ $json.driver_id }}\n\nWelcome SMS has been sent. ✅",
        "otherOptions": {}
      },
      "id": "dob-0006-0000-0000-000000000006",
      "name": "Slack - New Driver Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [-560, 560],
      "credentials": { "slackApi": { "id": "SLACK_CREDENTIAL_ID", "name": "VoiceOps Slack" } },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "fromEmail": "welcome@voiceops.app",
        "toEmail": "={{ $json.operator_email }}",
        "subject": "=⚠️ New Driver Registered (No Phone) — {{ $json.driver_name }}",
        "emailFormat": "text",
        "text": "=A new driver registered but has no phone number on file. Welcome SMS could not be sent.\n\nDriver Details:\nName:       {{ $json.driver_name }}\nEmail:      {{ $json.email || 'Not provided' }}\nRegistered: {{ $json.registered_at }}\nDriver ID:  {{ $json.driver_id }}\n\nPlease follow up manually to ensure they can receive shift instructions.\n\n— VoiceOps Onboarding System",
        "options": {}
      },
      "id": "dob-0007-0000-0000-000000000007",
      "name": "Email - No Phone Fallback",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [-560, 780],
      "credentials": { "smtp": { "id": "SMTP_CREDENTIAL_ID", "name": "VoiceOps SMTP" } },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Webhook - Driver Registered": {
      "main": [
        [
          { "node": "Normalize Driver Payload", "type": "main", "index": 0 }
        ]
      ]
    },
    "Normalize Driver Payload": {
      "main": [
        [
          { "node": "IF Has Phone", "type": "main", "index": 0 }
        ]
      ]
    },
    "IF Has Phone": {
      "main": [
        [
          { "node": "SMS - Welcome Message", "type": "main", "index": 0 },
          { "node": "Email - Notify Operator", "type": "main", "index": 0 },
          { "node": "Slack - New Driver Alert", "type": "main", "index": 0 }
        ],
        [
          { "node": "Email - No Phone Fallback", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "templateId": "voiceops-driver-onboarding" }
}
