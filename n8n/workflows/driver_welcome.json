{
  "name": "New Driver Welcome",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "driver-signup",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "from": "{{ $env.TWILIO_PHONE_NUMBER }}",
        "to": "={{ $json.phone }}",
        "body": "Welcome to VoiceOps! Your account is set up. Have a great shift."
      },
      "id": "send-welcome-sms",
      "name": "Send Welcome SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [450, 300],
      "credentials": {
        "twilioApi": {
          "id": "twilio-credentials"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "table": "drivers",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.driver_id }}",
            "welcome_sent_at": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "log-welcome",
      "name": "Log Welcome Sent",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Send Welcome SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Welcome SMS": {
      "main": [
        [
          {
            "node": "Log Welcome Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
