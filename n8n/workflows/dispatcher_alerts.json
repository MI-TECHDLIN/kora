{
  "name": "VoiceOps - Dispatcher Alerts & Escalations",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dispatcher-alert",
        "responseMode": "onReceived",
        "responseData": "{\"status\":\"received\"}",
        "options": {}
      },
      "id": "1a2b3c4d-0001-0000-0000-000000000001",
      "name": "Webhook - Dispatcher Alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1120, 300],
      "webhookId": "dispatcher-alert"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "driver_id", "value": "={{ $json.body.driver_id }}", "type": "string" },
            { "id": "f2", "name": "driver_name", "value": "={{ $json.body.driver_name }}", "type": "string" },
            { "id": "f3", "name": "alert_type", "value": "={{ $json.body.alert_type }}", "type": "string" },
            { "id": "f4", "name": "message", "value": "={{ $json.body.message }}", "type": "string" },
            { "id": "f5", "name": "severity", "value": "={{ $json.body.severity || 'normal' }}", "type": "string" },
            { "id": "f6", "name": "location", "value": "={{ $json.body.location || 'unknown' }}", "type": "string" },
            { "id": "f7", "name": "shift_id", "value": "={{ $json.body.shift_id }}", "type": "string" },
            { "id": "f8", "name": "timestamp", "value": "={{ $json.body.timestamp || $now.toISO() }}", "type": "string" },
            {
              "id": "f9",
              "name": "is_critical",
              "value": "={{ $json.body.severity === 'critical' || ['safety_incident','emergency','accident'].includes($json.body.alert_type) }}",
              "type": "boolean"
            },
            { "id": "f10", "name": "dispatcher_email", "value": "={{ $json.body.dispatcher_email || 'dispatcher@voiceops.app' }}", "type": "string" },
            { "id": "f11", "name": "supabase_url", "value": "={{ $json.body.supabase_url || '' }}", "type": "string" },
            { "id": "f12", "name": "supabase_service_key", "value": "={{ $json.body.supabase_service_key || '' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0002-0000-0000-000000000002",
      "name": "Normalize Alert Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-880, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.supabase_url }}/rest/v1/dispatcher_alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $json.supabase_service_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $json.supabase_service_key }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"driver_id\": $json.driver_id, \"driver_name\": $json.driver_name, \"alert_type\": $json.alert_type, \"message\": $json.message, \"severity\": $json.severity, \"location\": $json.location, \"shift_id\": $json.shift_id, \"created_at\": $json.timestamp, \"is_critical\": $json.is_critical } }}",
        "options": {}
      },
      "id": "1a2b3c4d-0007-0000-0000-000000000007",
      "name": "Log Alert to Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-560, 140],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.is_critical }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a2b3c4d-0003-0000-0000-000000000003",
      "name": "IF Critical Severity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-560, 360]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#dispatcher-critical" },
        "text": "=🚨 *CRITICAL DISPATCHER ALERT*\n*Driver:* {{ $json.driver_name }} ({{ $json.driver_id }})\n*Type:* {{ $json.alert_type }}\n*Message:* {{ $json.message }}\n*Location:* {{ $json.location }}\n*Shift:* {{ $json.shift_id }}\n*Time:* {{ $json.timestamp }}",
        "otherOptions": {}
      },
      "id": "1a2b3c4d-0004-0000-0000-000000000004",
      "name": "Slack - Critical Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [-280, 240],
      "credentials": { "slackApi": { "id": "SLACK_CREDENTIAL_ID", "name": "VoiceOps Slack" } },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "fromEmail": "alerts@voiceops.app",
        "toEmail": "={{ $json.dispatcher_email }}",
        "subject": "=🚨 CRITICAL: {{ $json.alert_type }} - Driver {{ $json.driver_name }}",
        "emailFormat": "text",
        "text": "=Critical dispatcher alert requiring immediate attention.\n\nDriver: {{ $json.driver_name }} ({{ $json.driver_id }})\nAlert type: {{ $json.alert_type }}\nMessage: {{ $json.message }}\nLocation: {{ $json.location }}\nShift ID: {{ $json.shift_id }}\nTimestamp: {{ $json.timestamp }}\n\nThis is an automated escalation from VoiceOps.",
        "options": {}
      },
      "id": "1a2b3c4d-0005-0000-0000-000000000005",
      "name": "Email - Escalation",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [-280, 420],
      "credentials": { "smtp": { "id": "SMTP_CREDENTIAL_ID", "name": "VoiceOps SMTP" } },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#dispatcher-alerts" },
        "text": "=📋 *Dispatcher Alert*\n*Driver:* {{ $json.driver_name }} ({{ $json.driver_id }})\n*Type:* {{ $json.alert_type }}\n*Message:* {{ $json.message }}\n*Location:* {{ $json.location }}\n*Shift:* {{ $json.shift_id }}\n*Time:* {{ $json.timestamp }}",
        "otherOptions": {}
      },
      "id": "1a2b3c4d-0006-0000-0000-000000000006",
      "name": "Slack - Standard Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [-280, 600],
      "credentials": { "slackApi": { "id": "SLACK_CREDENTIAL_ID", "name": "VoiceOps Slack" } },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Webhook - Dispatcher Alert": {
      "main": [
        [
          { "node": "Normalize Alert Payload", "type": "main", "index": 0 }
        ]
      ]
    },
    "Normalize Alert Payload": {
      "main": [
        [
          { "node": "Log Alert to Supabase", "type": "main", "index": 0 },
          { "node": "IF Critical Severity", "type": "main", "index": 0 }
        ]
      ]
    },
    "IF Critical Severity": {
      "main": [
        [
          { "node": "Slack - Critical Channel", "type": "main", "index": 0 },
          { "node": "Email - Escalation", "type": "main", "index": 0 }
        ],
        [
          { "node": "Slack - Standard Channel", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "templateId": "voiceops-dispatcher-alert" }
}
