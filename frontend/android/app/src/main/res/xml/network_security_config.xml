<?xml version="1.0" encoding="utf-8"?>
<!-- just_audio plays the co-rider's voice through a proxy on the device's
     own loopback address (lib/core/audio/voice_playback.dart), which the
     player reaches over plain http. Cleartext is allowed for loopback only;
     everything else stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Local development backend on the phone's Wi-Fi network. -->
        <domain includeSubdomains="false">10.24.254.107</domain>
    </domain-config>
</network-security-config>
